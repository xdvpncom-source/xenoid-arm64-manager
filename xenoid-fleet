NAME_PREFIX = "phone-"
VERSION = "v0.1.19"
DEVICE_ID = re.compile(r"[1-9][0-9]{0,25}")
INSTALL_ROOT = Path(__file__).resolve().parent
CHROME_SCHEMA = "dev.xenoid.fleet.chrome-baseline/v1"
CHROME_RUNTIME_SCHEMA = "dev.xenoid.fleet.chrome-baseline/v2"
CHROME_PACKAGE = "com.android.chrome"
CHROME_VERSION_LINE = re.compile(r"package:com\.android\.chrome versionCode:([0-9]+)")
CHROME_FILENAME = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,119}\.apk")
ONE_SHA256 = re.compile(r"[0-9a-f]{64}")
IMAGE_ID = re.compile(r"sha256:[0-9a-f]{64}")
REDROID_BASE = "redroid/redroid@sha256:5a42a569ee1d7c71796c0385e906cbaa4c3e0a162a56d9f26b29bdb1befac13b"
RUNTIME_LIBRARY = "/system/lib64/libcutils.so"
RUNTIME_LIBRARY_LIMIT = 2 * 1024 * 1024
PROXY_DEFAULT_SCHEMA = "dev.xenoid.fleet.proxy-default/v1"
PROXY_SOURCE_LIMIT = 1024 * 1024
LIFECYCLE_COMMANDS = {"init", "delete"}
GLOBAL_COMMANDS = {
    "build", "install-runtime", "instance", "linux-binderfs",
    "package-release", "verify-release",
}
ADB_COMMANDS_WITH_GLOBAL_EFFECTS = {
    "attach", "detach", "disconnect", "host-features", "kill-server",
    "mdns", "pair", "reconnect", "server", "start-server", "track-devices",
}
RECREATE_RECOVERY_CODES = {
    "runtime_image_required", "convergence_pending", "device_regeneration_pending",
    "google_services_assets_missing", "runtime_image_artifact_snapshot_invalid",
    "runtime_preflight_failed",
}


class FleetError(Exception):
    pass


@contextlib.contextmanager
def private_baseline_file(path: Path, label: str = "Chrome baseline"):
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(descriptor, "rb") as stream:
        info = os.fstat(stream.fileno())
        if (not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600
                or (info.st_uid, info.st_gid) != (0, 0) or info.st_nlink != 1):
            raise FleetError(f"{label} file {path.name} must be a private root-owned file")
        yield stream


def baseline_apk(directory: Path, value) -> Path:
    if not isinstance(value, dict) or set(value) != {"file", "sha256"}:
        raise FleetError("Chrome baseline has an invalid APK record")
    filename, expected = value["file"], value["sha256"]
    if (not isinstance(filename, str) or not CHROME_FILENAME.fullmatch(filename)
            or not isinstance(expected, str) or not ONE_SHA256.fullmatch(expected)):
        raise FleetError("Chrome baseline has an invalid APK filename or SHA-256")
    path = directory / filename
    verify_baseline_file(path, expected)
    return path


def verify_baseline_file(path: Path, expected: str) -> None:
    digest = hashlib.sha256()
    with private_baseline_file(path) as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    if digest.hexdigest() != expected:
        raise FleetError(f"Chrome baseline SHA-256 mismatch for {path.name}")


@dataclass(frozen=True)
class ChromeRuntime:
    library: Path
    sha256: str

    @classmethod
    def load(cls, directory: Path, record) -> ChromeRuntime:
        if (not isinstance(record, dict) or set(record) != {"file", "sha256"}
                or record["file"] != "libcutils.so" or not isinstance(record["sha256"], str)
                or not ONE_SHA256.fullmatch(record["sha256"])):
            raise FleetError("Chrome baseline has an invalid runtime library record")
        runtime = cls(directory / record["file"], record["sha256"])
        runtime.library_bytes()
        return runtime

    def library_bytes(self) -> bytes:
        with private_baseline_file(self.library) as stream:
            body = stream.read(RUNTIME_LIBRARY_LIMIT + 1)
        if not 0 < len(body) <= RUNTIME_LIBRARY_LIMIT:
            raise FleetError("Chrome baseline runtime library has an invalid size")
        if hashlib.sha256(body).hexdigest() != self.sha256:
            raise FleetError("Chrome baseline SHA-256 mismatch for libcutils.so")
        return body

    @property
    def image(self) -> str:
        digest = hashlib.sha256(f"{REDROID_BASE}\n{self.sha256}".encode()).hexdigest()
        return f"xenoid/redroid:chrome-memfd-{digest}"

    def base_image_id(self, context: str, *, build: bool) -> str:
        with fleet_lock("chrome-runtime-image") if build else contextlib.nullcontext():
            return self._base_image_id(context, build=build)

    def _base_image_id(self, context: str, *, build: bool) -> str:
        parent = inspect_docker_image(context, REDROID_BASE)
        if parent is None or parent.get("Id") != REDROID_BASE.split("@", 1)[1]:
            raise FleetError("the pinned Redroid base image is unavailable")
        parent_layers = docker_image_layers(parent)
        labels = {"dev.xenoid.fleet.chrome-parent": REDROID_BASE, "dev.xenoid.fleet.chrome-libcutils-sha256": self.sha256}
        image = inspect_docker_image(context, self.image)
        if image is None and build:
            with tempfile.TemporaryDirectory(prefix="xenoid-fleet-chrome-image-") as staging:
                stage = Path(staging)
                library = stage / "libcutils.so"
                library.write_bytes(self.library_bytes())
                (stage / "Dockerfile").write_text(
                    f"FROM {REDROID_BASE}\nCOPY --chown=0:0 --chmod=0644 libcutils.so {RUNTIME_LIBRARY}\n",
                    encoding="utf-8",
                )
                command = ["build", "--platform", "linux/arm64", "--pull=false", "--network=none", "--tag", self.image]
                for key, value in labels.items():
                    command.extend(("--label", f"{key}={value}"))
                result = docker_call(context, [*command, staging])
                if result.returncode:
                    raise FleetError(f"Chrome-compatible Redroid image build failed: {result.stderr.strip()}")
            image = inspect_docker_image(context, self.image)
        if image is None:
            raise FleetError("Chrome-compatible Redroid image is unavailable")
        layers = docker_image_layers(image)
        config = image.get("Config")
        current_labels = config.get("Labels") if isinstance(config, dict) else None
        image_id = image.get("Id")
        if (len(layers) != len(parent_layers) + 1 or layers[:-1] != parent_layers
                or not isinstance(current_labels, dict)
                or any(current_labels.get(key) != value for key, value in labels.items())
                or not isinstance(image_id, str) or not IMAGE_ID.fullmatch(image_id)):
            raise FleetError("Chrome-compatible Redroid image does not match its expected parent and library")
        return image_id

    def verify_running(self, upstream: Upstream, device_id: str, base_id: str) -> None:
        status, code = upstream.document(["status"], device_id)
        runtime = status.get("runtimeIdentity")
        image = status.get("runtimeImage")
        identity = status.get("runtimeImageIdentity")
        if (code or status.get("ok") is not True or status.get("running") is not True
                or not all(isinstance(value, dict) for value in (runtime, image, identity))
                or image.get("baseImageId") != base_id or not runtime.get("containerId")
                or not IMAGE_ID.fullmatch(str(runtime.get("imageId")))
                or identity.get("containerImageSha256") != runtime["imageId"]
                or not ONE_SHA256.fullmatch(str(identity.get("desiredBootInputSha256")))
                or identity.get("containerBootInputSha256") != identity["desiredBootInputSha256"]
                or image.get("bootInputSha256") != identity["desiredBootInputSha256"]):
            raise FleetError("the Chrome-compatible Xenoid runtime is not active")
        result, code = upstream.document(["adb", "shell", "sha256sum", RUNTIME_LIBRARY], device_id)
        stdout = result.get("stdout")
        if (code or result.get("ok") is not True or not isinstance(stdout, str)
                or stdout.split() != [self.sha256, RUNTIME_LIBRARY]):
            raise FleetError("the running Android library does not match the Chrome baseline")


def docker_call(context: str, arguments: list[str]) -> subprocess.CompletedProcess:
    environment = dict(os.environ)
    for key in ("DOCKER_HOST", "DOCKER_CONTEXT"):
        environment.pop(key, None)
    return subprocess.run(["docker", "--context", context, *arguments], env=environment,
                          stdin=subprocess.DEVNULL, capture_output=True, text=True, check=False)


def inspect_docker_image(context: str, reference: str) -> dict | None:
    result = docker_call(context, ["image", "inspect", "--format", "{{json .}}", reference])
    if result.returncode:
        if "no such image" in result.stderr.lower() or "no such object" in result.stderr.lower():
            return None
        raise FleetError(f"Docker could not inspect {reference}: {result.stderr.strip()}")
    try:
        image = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise FleetError("Docker returned an invalid image inspection result") from error
    if not isinstance(image, dict):
        raise FleetError("Docker returned an invalid image inspection result")
    return image


def docker_image_layers(image: dict) -> list[str]:
    rootfs = image.get("RootFS")
    layers = rootfs.get("Layers") if isinstance(rootfs, dict) else None
    if (image.get("Architecture") != "arm64" or image.get("Os") != "linux"
            or not isinstance(layers, list) or not layers
            or not all(isinstance(layer, str) and IMAGE_ID.fullmatch(layer) for layer in layers)):
        raise FleetError("Docker image has an invalid ARM64 root filesystem")
    return layers


@dataclass(frozen=True)
class ChromeBaseline:
    version_code: int
    chrome: tuple[Path, ...]
    trichrome: Path | None
    runtime: ChromeRuntime | None = None

    @classmethod
    def load(cls) -> ChromeBaseline | None:
        directory = INSTALL_ROOT / "chrome-baseline"
        try:
            info = directory.lstat()
        except FileNotFoundError:
            return None
        if (not stat.S_ISDIR(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o700
                or (info.st_uid, info.st_gid) != (0, 0)):
            raise FleetError("Chrome baseline directory must be private and root-owned")
        with private_baseline_file(directory / "manifest.json") as stream:
            body = stream.read(65_537)
        if len(body) > 65_536:
            raise FleetError("Chrome baseline manifest exceeded its size limit")
        try:
            manifest = json.loads(body)
        except (UnicodeError, ValueError) as error:
            raise FleetError("Chrome baseline manifest is invalid JSON") from error
        keys = {"schema", "version_code", "chrome", "trichrome"}
        schema = manifest.get("schema") if isinstance(manifest, dict) else None
        if schema == CHROME_RUNTIME_SCHEMA:
            keys.add("runtime")
        if (schema not in (CHROME_SCHEMA, CHROME_RUNTIME_SCHEMA) or set(manifest) != keys
                or type(manifest["version_code"]) is not int
                or not 1 <= manifest["version_code"] <= 2**63 - 1 or not isinstance(manifest["chrome"], list)
                or not 1 <= len(manifest["chrome"]) <= 64):
            raise FleetError("Chrome baseline manifest does not match the expected schema")
        chrome = tuple(baseline_apk(directory, apk) for apk in manifest["chrome"])
        library = manifest["trichrome"]
        trichrome = baseline_apk(directory, library) if library is not None else None
        if (chrome[0].name != "base.apk" or len(set(chrome)) != len(chrome)
                or any(apk.name == "trichrome.apk" for apk in chrome)
                or (trichrome is not None and trichrome.name != "trichrome.apk")):
            raise FleetError("Chrome baseline requires base.apk first and unique split and library filenames")
        runtime = ChromeRuntime.load(directory, manifest["runtime"]) if schema == CHROME_RUNTIME_SCHEMA else None
        return cls(manifest["version_code"], chrome, trichrome, runtime)

    def converge(self, upstream: Upstream, device_id: str, base_id: str | None = None) -> None:
        if self.runtime is not None:
            if base_id is None:
                raise FleetError("the Chrome-compatible Xenoid runtime could not be verified")
            self.runtime.verify_running(upstream, device_id, base_id)
        installed = installed_chrome_version(upstream, device_id)
        if installed is not None and installed >= self.version_code:
            return
        commands = []
        if self.trichrome is not None:
            commands.append(["app", "install", str(self.trichrome)])
        if len(self.chrome) == 1:
            commands.append(["app", "install", str(self.chrome[0])])
        else:
            commands.append(["adb", "install-multiple", "-r", *map(str, self.chrome)])
        for command in commands:
            result = upstream.call(command, device_id=device_id, capture=True)
            if result.returncode:
                if result.stdout:
                    print(result.stdout, end="", file=sys.stderr)
                if result.stderr:
                    print(result.stderr, end="", file=sys.stderr)
                raise FleetError(f"Chrome baseline failed during upstream {' '.join(command[:2])}")
        installed = installed_chrome_version(upstream, device_id)
        if installed is None or installed < self.version_code:
            raise FleetError("The Chrome baseline version could not be verified after installation")
        print(f"{NAME_PREFIX}{device_id}: Chrome baseline installed (versionCode {installed})", file=sys.stderr)


def installed_chrome_version(upstream: Upstream, device_id: str) -> int | None:
    result, code = upstream.document(
        ["adb", "shell", "pm", "list", "packages", "--show-versioncode", "--user", "0", CHROME_PACKAGE], device_id
    )
    stdout = result.get("stdout")
    if code or result.get("ok") is not True or not isinstance(stdout, str):
        raise FleetError("Android did not return the installed Chrome package version")
    for line in stdout.splitlines():
        if match := CHROME_VERSION_LINE.fullmatch(line.strip()):
            return int(match[1])
    return None


@dataclass(frozen=True)
class ProxyDefault:
    source: bytes = field(repr=False)
    kind: str
    udp_allowed: bool
    ipv6_allowed: bool
    allow_insecure_http: bool

    @classmethod
    def load(cls) -> ProxyDefault | None:
        directory = INSTALL_ROOT / "proxy-default"
        try:
            info = directory.lstat()
        except FileNotFoundError:
            return None
        if (not stat.S_ISDIR(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o700
                or (info.st_uid, info.st_gid) != (0, 0)):
            raise FleetError("Proxy default directory must be private and root-owned")
        with private_baseline_file(directory / "manifest.json", "Proxy default") as stream:
            body = stream.read(4097)
        if len(body) > 4096:
            raise FleetError("Proxy default manifest exceeded its size limit")
        try:
            manifest = json.loads(body)
        except (UnicodeError, ValueError):
            raise FleetError("Proxy default manifest is invalid JSON") from None
        flags = ("udpAllowed", "ipv6Allowed", "allowInsecureHttp")
        if (not isinstance(manifest, dict) or set(manifest) != {"schema", "kind", "sha256", *flags}
                or manifest["schema"] != PROXY_DEFAULT_SCHEMA
                or manifest["kind"] not in ("endpoint", "uri_list", "clash", "subscription")
                or not isinstance(manifest["sha256"], str) or not ONE_SHA256.fullmatch(manifest["sha256"])
                or not all(type(manifest[flag]) is bool for flag in flags)):
            raise FleetError("Proxy default manifest does not match the expected schema")
        with private_baseline_file(directory / "source.conf", "Proxy default") as stream:
            source = stream.read(PROXY_SOURCE_LIMIT + 1)
        if not source or len(source) > PROXY_SOURCE_LIMIT:
            raise FleetError("Proxy default source has an invalid size")
        try:
            source.decode("utf-8")
        except UnicodeError:
            raise FleetError("Proxy default source is invalid UTF-8") from None
        if hashlib.sha256(source).hexdigest() != manifest["sha256"]:
            raise FleetError("Proxy default source SHA-256 mismatch")
        return cls(source, manifest["kind"], *(manifest[flag] for flag in flags))

    def converge(self, upstream: Upstream, device_id: str) -> None:
        status = self._request(upstream, device_id, ["status"], "could not read native proxy status")
        if status.get("configured") is True:
            return
        if status.get("configured") is not False or status.get("stateReadable") is not True:
            raise FleetError("could not verify that the native proxy is unconfigured")
        with tempfile.TemporaryDirectory(prefix="xenoid-fleet-proxy-") as staging:
            source = Path(staging) / "source.conf"
            with open(source, "xb", opener=private_open) as stream:
                stream.write(self.source)
            flags = ["--kind", self.kind, "--enable",
                     "--udp" if self.udp_allowed else "--no-udp",
                     "--ipv6" if self.ipv6_allowed else "--no-ipv6"]
            if self.allow_insecure_http:
                flags.append("--allow-insecure-http")
            verified = self._request(upstream, device_id, ["import", str(source), *flags],
                                     "native proxy default import failed")
        if (verified.get("configured") is not True or verified.get("enabled") is not True
                or verified.get("quarantined") is not False or verified.get("checkCompleted") is not True
                or verified.get("sourceKind") != self.kind
                or verified.get("udpAllowed") is not self.udp_allowed
                or verified.get("ipv6Allowed") is not self.ipv6_allowed
                or verified.get("allowInsecureHttp") is not self.allow_insecure_http):
            raise FleetError("native proxy default did not pass its fresh data-plane check")

    @staticmethod
    def _request(upstream: Upstream, device_id: str, args: list[str], error: str) -> dict:
        try:
            result = upstream.call(["proxy", *args], device_id=device_id, capture=True)
            reply = json.loads(result.stdout)
        except (OSError, ValueError):
            raise FleetError(error) from None
        if result.returncode or not isinstance(reply, dict) or reply.get("ok") is not True:
            raise FleetError(error)
        return reply


def device_ids(selector: str) -> list[str]:
    values = selector.split(",")
    if any(not DEVICE_ID.fullmatch(value) for value in values):
        raise FleetError("use positive decimal IDs without leading zeros, e.g. 1 or 1,2")
    if len(set(values)) != len(values):
        raise FleetError("a device ID may appear only once per command")
    return values


def validate_run_command(command: list[str], *, multiple: bool) -> None:
    if not command or command[0].startswith("-"):
        raise FleetError("supply an upstream command after --, without global options")
    if command[0] in LIFECYCLE_COMMANDS:
        raise FleetError("use fleet create or delete for this lifecycle operation")
    if command[0] in GLOBAL_COMMANDS:
        raise FleetError("this upstream command is global; run it directly in the checkout")
    if command[0] == "ebpf" and command[1:] != ["status"]:
        raise FleetError("shared engine maintenance must be run directly in the checkout")
    if command[0] == "adb":
        if len(command) < 2 or command[1].startswith("-"):
            raise FleetError("pass an ADB subcommand without server or device selection flags")
        if command[1] in ADB_COMMANDS_WITH_GLOBAL_EFFECTS or command[1].startswith("wait-for-any-"):
            raise FleetError("this ADB operation is not scoped to the selected device")
    if multiple and (command[0] == "view" or "--stdin" in command[:3] or command == ["adb", "shell"]):
        raise FleetError("interactive or stdin-dependent commands require one device ID")


def device_lock(device_id: str):
    return fleet_lock(NAME_PREFIX + device_id)


@contextlib.contextmanager
def fleet_lock(name: str) -> Iterator[None]:
    directory = (Path.home() / ".xenoid").resolve() / "fleet-locks"
    directory.parent.mkdir(mode=0o700, exist_ok=True)
    directory.mkdir(mode=0o700, exist_ok=True)
    info = directory.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise FleetError("the fleet lock directory must be private and operator-owned")
    descriptor = os.open(directory / f"{name}.lock",
                         os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        info = os.fstat(descriptor)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or info.st_nlink != 1 or info.st_mode & 0o077):
            raise FleetError("the fleet lock must be a private operator-owned regular file")
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        os.close(descriptor)


class Upstream:
    def __init__(self) -> None:
        root = os.environ.get("XENOID_FLEET_UPSTREAM")
        self.root = Path(root).expanduser().resolve() if root else INSTALL_ROOT / "upstream"
        executable = self.root / "xenoid"
        if not executable.is_file() or not os.access(executable, os.X_OK):
            raise FleetError(f"Xenoid launcher is unavailable at {executable}")
        self.prefix = [str(executable)]
        toolchain = INSTALL_ROOT / "toolchain" / "env.sh"
        if toolchain.is_file():
            self.prefix = ["bash", "-e", "-c", 'source "$1"; shift; exec "$@"',
                           "xenoid-fleet", str(toolchain), *self.prefix]
        self.environment = dict(os.environ, XENOID_PROJECT=str(self.root))
        self.environment.pop("XENOID_EXPECT_INSTANCE_ID", None)
        self.environment.pop("XENOID_INSTANCE", None)

    def call(self, arguments: list[str], *, device_id: str | None = None,
             capture: bool = False, interactive: bool = False) -> subprocess.CompletedProcess:
        argv = list(self.prefix)
        if device_id is not None:
            argv.extend(("--instance", NAME_PREFIX + device_id))
        argv.extend(arguments)
        with contextlib.ExitStack() as resources:
            environment = self.environment
            if (arguments[0] in {"up", "runtime-build-image"}
                    and not environment.get("BUILDX_CONFIG") and not environment.get("BUILDX_BUILDER")):
                # A fresh Buildx client ID isolates canonical build contexts from stale source snapshots.
                config = resources.enter_context(tempfile.TemporaryDirectory(prefix="xenoid-fleet-buildx-"))
                environment = dict(environment, BUILDX_CONFIG=config)
            return subprocess.run(argv, env=environment, text=True, capture_output=capture,
                                  stdin=None if interactive else subprocess.DEVNULL, check=False)

    def document(self, arguments: list[str], device_id: str | None = None) -> tuple[dict, int]:
        result = self.call(arguments, device_id=device_id, capture=True)
        if result.stderr:
            print(result.stderr, file=sys.stderr, end="")
        try:
            document = json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise FleetError(f"Xenoid {' '.join(arguments)} returned invalid JSON") from error
        if not isinstance(document, dict):
            raise FleetError(f"Xenoid {' '.join(arguments)} did not return a JSON object")
        return document, result.returncode

    def registry(self) -> dict[str, dict]:
        document, returncode = self.document(["instance", "list"])
        rows = document.get("instances")
        if returncode != 0 or document.get("ok") is not True or not isinstance(rows, list):
            raise FleetError("Xenoid could not read the instance registry")
        entries = {}
        for row in rows:
            name = row.get("instanceName") if isinstance(row, dict) else None
            if not isinstance(name, str):
                raise FleetError("Xenoid returned an invalid registry entry")
            if not name.startswith(NAME_PREFIX):
                continue
            device_id = name[len(NAME_PREFIX):]
            if DEVICE_ID.fullmatch(device_id):
                if device_id in entries:
                    raise FleetError(f"Xenoid returned a duplicate registry entry for {name}")
                entries[device_id] = row
        return entries

    def require(self, device_id: str, arguments: list[str]) -> None:
        result = self.call(arguments, device_id=device_id)
        if result.returncode != 0:
            raise FleetError(f"upstream {' '.join(arguments[:2])} exited with status {result.returncode}")

    def recreate(self, device_id: str) -> None:
        # The following up converges ADB and the daemon on the replacement container.
        arguments = ["start", "--recreate", "--no-wait"]
        result = self.call(arguments, device_id=device_id, capture=True)
        print(result.stdout, end="", flush=True)
        print(result.stderr, end="", file=sys.stderr, flush=True)
        if result.returncode == 0:
            return
        try:
            response = json.loads(result.stdout)
            code = response.get("error") if isinstance(response, dict) else None
        except json.JSONDecodeError:
            code = None
        if not isinstance(code, str) or code not in RECREATE_RECOVERY_CODES:
            raise FleetError(f"upstream start --recreate exited with status {result.returncode}")
        print(f"{NAME_PREFIX}{device_id}: recovering {code} through upstream up", file=sys.stderr)
        self.require(device_id, ["up"])
        self.require(device_id, arguments)

    @contextlib.contextmanager
    def validated_profile(self, filename: str | None) -> Iterator[str | None]:
        if filename is None:
            yield None
            return
        validator = self.root / "scripts" / "import-pixel-template.py"
        if not validator.is_file():
            raise FleetError("the upstream fingerprint validator is unavailable")
        path = Path(filename).expanduser()
        try:
            if not path.is_file():
                raise FleetError("the profile must be a regular JSON file")
            data = json.loads(path.read_text(encoding="utf-8"))
            normalize = runpy.run_path(str(validator))["normalize"]
            normalized = normalize(data, path.name)
        except (OSError, ValueError, KeyError) as error:
            raise FleetError(f"profile validation failed: {error}") from error
        with tempfile.TemporaryDirectory(prefix="xenoid-fleet-profile-") as staging:
            profile = Path(staging) / "profile.json"
            with open(profile, "x", encoding="utf-8", opener=private_open) as stream:
                json.dump(normalized, stream, ensure_ascii=False, allow_nan=False)
            yield str(profile)


def private_open(path: str, flags: int) -> int:
    return os.open(path, flags, 0o600)


def selection(upstream: Upstream, selector: str) -> list[str]:
    if selector == "all":
        return sorted(upstream.registry(), key=int)
    return device_ids(selector)


def check_registry_entry(device_id: str, row: dict | None) -> None:
    if row is not None and row.get("ok") is False:
        raise FleetError(f"registry entry for {NAME_PREFIX}{device_id} is unhealthy")


def instance_settings(upstream: Upstream, device_id: str) -> dict:
    result, code = upstream.document(["config", "show"], device_id)
    settings = result.get("config")
    if code or result.get("ok") is not True or not isinstance(settings, dict):
        raise FleetError("could not read the instance configuration")
    return settings


def docker_context(settings: dict) -> str:
    configured = settings.get("docker_context", "")
    if not isinstance(configured, str):
        raise FleetError("the instance has an invalid Docker context")
    return configured.strip() or "default"


def verify_migration_base(context: str, reference) -> None:
    if not isinstance(reference, str) or not reference:
        raise FleetError("could not verify the configured Android base image")
    image = inspect_docker_image(context, reference)
    if image is None:
        raise FleetError("could not verify the configured Android base image")
    labels = (image.get("Config") or {}).get("Labels") or {}
    if (image.get("Id") != REDROID_BASE.split("@", 1)[1]
            and labels.get("dev.xenoid.fleet.chrome-parent") != REDROID_BASE):
        raise FleetError("the Chrome baseline cannot replace a separately configured Android base image")


def create_device(upstream: Upstream, device_id: str, args: argparse.Namespace,
                  profile: str | None, baseline: ChromeBaseline | None,
                  proxy_default: ProxyDefault | None = None) -> None:
    row = upstream.registry().get(device_id)
    check_registry_entry(device_id, row)
    runtime = baseline.runtime if baseline is not None else None
    base_id = None
    if row is None:
        command = ["init", "--config", str(upstream.root / "examples" / "config-linux-arm.json")]
        if args.no_google_services:
            command.append("--no-google-services")
        if runtime is not None:
            base_id = runtime.base_image_id("default", build=True)
            command.extend(("--image", runtime.image))
        upstream.require(device_id, command)
    else:
        settings = instance_settings(upstream, device_id) if args.no_google_services or runtime is not None else {}
        if args.no_google_services:
            if settings.get("google_services_provider") != "none":
                raise FleetError("Google services on an existing device require a new device ID to change")
        if runtime is not None:
            context = docker_context(settings)
            configured_image = settings.get("image")
            if configured_image != runtime.image:
                verify_migration_base(context, configured_image)
            base_id = runtime.base_image_id(context, build=True)
        if runtime is not None and settings.get("image") != runtime.image:
            # Native up recreates the container when its configured boot image changes.
            upstream.require(device_id, ["config", "set", "--image", runtime.image])
        else:
            upstream.recreate(device_id)
    upstream.require(device_id, ["up"])
    if profile is not None:
        upstream.require(device_id, ["device", "apply", profile, "--instance-identity"])
    if proxy_default is not None:
        proxy_default.converge(upstream, device_id)
    if baseline is not None:
        baseline.converge(upstream, device_id, base_id)
    qa_reconcile([device_id], force=True)


def qa_reconcile(ids: list[str], *, force: bool = False, required: bool = False, report: bool = False) -> int:
    helper = INSTALL_ROOT / "panel-scripts" / "qa_resources.py"
    # A source checkout may be used without installing the optional host addon.
    # Installed releases always include it; the installer verifies its manifest.
    if not helper.is_file():
        if required or (INSTALL_ROOT / ".qa-addon-installed").exists():
            raise FleetError("QA resource addon is missing; rerun the Fleet installer")
        return 0
    command = [sys.executable, str(helper)]
    if force:
        command.append("--force")
    for device_id in ids:
        command.extend(("--device", NAME_PREFIX + device_id))
    # Lifecycle callers retain the native command's stdout protocol. Explicit
    # `qa reconcile` exposes its own JSON reports to the caller.
    result = subprocess.run(command, stdin=subprocess.DEVNULL,
                            stdout=None if report else sys.stderr, check=False)
    if result.returncode:
        raise FleetError("QA resource convergence remains pending; see xenoid-qa-resources.service")
    return 0


def list_devices(upstream: Upstream, *, as_json: bool) -> int:
    devices = []
    registry = upstream.registry()
    for device_id, row in sorted(registry.items(), key=lambda item: int(item[0])):
        item = {**row, "id": int(device_id)}
        try:
            check_registry_entry(device_id, row)
            status, code = upstream.document(["status"], device_id)
            item.update({"ok": code == 0 and status.get("ok") is True, "status": status})
        except FleetError as error:
            item.update({"ok": False, "error": str(error)})
        devices.append(item)
    ok = all(item["ok"] for item in devices)
    if as_json:
        print(json.dumps({"ok": ok, "devices": devices}, indent=2))
    else:
        print("ID\tINSTANCE\tRUNTIME\tNEXT ACTION")
        for item in devices:
            status = item.get("status", {})
            running = status.get("running")
            runtime = "running" if running is True else "not running" if running is False else "unknown"
            action = status.get("recommendedAction", item.get("error", "-"))
            print(f"{item['id']}\t{item['instanceName']}\t{runtime}\t{action}")
    return int(not ok)


def report_failure(device_id: str, error: Exception) -> None:
    print(f"{NAME_PREFIX}{device_id}: {error}", file=sys.stderr)


def run_devices(upstream: Upstream, ids: list[str], command: list[str]) -> int:
    multiple = len(ids) > 1
    validate_run_command(command, multiple=multiple)
    baseline = ChromeBaseline.load() if command == ["up"] else None
    proxy_default = ProxyDefault.load() if command == ["up"] else None
    failed = False
    for device_id in ids:
        if multiple:
            print(f"{NAME_PREFIX}{device_id}:", file=sys.stderr)
        try:
            with device_lock(device_id):
                code = upstream.call(command, device_id=device_id, interactive=not multiple).returncode
                if code == 0 and proxy_default is not None:
                    proxy_default.converge(upstream, device_id)
                if code == 0 and baseline is not None:
                    if baseline.runtime is None:
                        baseline.converge(upstream, device_id)
                    else:
                        settings = instance_settings(upstream, device_id)
                        if settings.get("image") == baseline.runtime.image:
                            base_id = baseline.runtime.base_image_id(docker_context(settings), build=False)
                            baseline.converge(upstream, device_id, base_id)
                if (code == 0 and command and command[0] in {"up", "start", "recreate"}
                        and "--no-wait" not in command and "--dry-run" not in command):
                    qa_reconcile([device_id], force=True)
        except (OSError, FleetError) as error:
            report_failure(device_id, error)
            code = 1
        if not multiple:
            return code if code >= 0 else 128 - code
        if code != 0:
            report_failure(device_id, FleetError(f"upstream exited with status {code}"))
            failed = True
    return int(failed)


def execute(args: argparse.Namespace, command: list[str]) -> int:
    if args.action == "qa" and args.qa_action == "configure":
        helper = INSTALL_ROOT / "panel-scripts" / "qa_resources.py"
        if not helper.is_file():
            raise FleetError("QA resource addon is not installed")
        return subprocess.run([sys.executable, str(helper), "--configure"], check=False).returncode
    upstream = Upstream()
    if args.action == "list":
        return list_devices(upstream, as_json=args.json)
    ids = device_ids(args.ids) if args.action == "create" else selection(upstream, args.ids)
    if args.action == "qa" and args.qa_action == "upgrade-proxy":
        helper = INSTALL_ROOT / "upgrade-proxy-control.py"
        if not helper.is_file() or args.timeout < 0:
            raise FleetError("Install the current proxy upgrader and use a nonnegative timeout")
        command = [sys.executable, str(helper), "--timeout", str(args.timeout)]
        for device_id in ids:
            command.extend(("--device", NAME_PREFIX + device_id))
        return subprocess.run(command, stdin=subprocess.DEVNULL, check=False).returncode
    if args.action == "qa":
        return qa_reconcile(ids, force=args.force, required=True, report=True)
    if args.action == "run":
        return run_devices(upstream, ids, command)
    baseline = ChromeBaseline.load() if args.action == "create" else None
    proxy_default = ProxyDefault.load() if args.action == "create" else None
    filename = args.profile if args.action == "create" else None
    failed = False
    with upstream.validated_profile(filename) as profile:
        for device_id in ids:
            if len(ids) > 1:
                print(f"{NAME_PREFIX}{device_id}:", file=sys.stderr)
            try:
                with device_lock(device_id):
                    if args.action == "create":
                        create_device(upstream, device_id, args, profile, baseline, proxy_default)
                    else:
                        upstream.require(device_id, ["delete"] if args.yes else ["delete", "--dry-run"])
            except (OSError, FleetError) as error:
                report_failure(device_id, error)
                failed = True
    return int(failed)


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(prog="xenoid-fleet", description=__doc__)
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    commands = parser.add_subparsers(dest="action", required=True)
    listing = commands.add_parser("list", help="list registered numeric devices and their status")
    listing.add_argument("--json", action="store_true")
    create = commands.add_parser("create", help="create or recreate devices while preserving existing data")
    create.add_argument("ids", metavar="ID[,ID...]")
    create.add_argument("profile", nargs="?", metavar="PROFILE")
    create.add_argument("--no-google-services", action="store_true")
    delete = commands.add_parser("delete", help="preview or permanently delete selected devices")
    delete.add_argument("ids", metavar="ID|CSV|all")
    confirm = delete.add_mutually_exclusive_group()
    confirm.add_argument("--dry-run", action="store_true", help="preview (the default)")
    confirm.add_argument("--yes", action="store_true", help="permanently delete the selected devices")
    run = commands.add_parser("run", help="pass a stock instance command to the selected devices")
    run.add_argument("ids", metavar="ID|CSV|all")
    run.add_argument("command", nargs=argparse.REMAINDER, metavar="-- COMMAND [ARG ...]")
    qa = commands.add_parser("qa", help="manage panel resource defaults and native proxy control")
    qa_commands = qa.add_subparsers(dest="qa_action", required=True)
    qa_configure = qa_commands.add_parser("configure", help="atomically store JSON from standard input")
    qa_configure.add_argument("--json-stdin", required=True, action="store_true")
    qa_apply = qa_commands.add_parser("reconcile", help="apply defaults once per container boot/configuration")
    qa_apply.add_argument("ids", metavar="ID|CSV|all")
    qa_apply.add_argument("--force", action="store_true", help="explicitly reapply even when already marked")
    qa_upgrade = qa_commands.add_parser("upgrade-proxy", help="refresh enabled running proxies after native control updates")
    qa_upgrade.add_argument("ids", metavar="ID|CSV|all")
    qa_upgrade.add_argument("--timeout", type=int, default=180, help="native lock/setup budget; 0 waits without a deadline")
    args = parser.parse_args(argv)
    command = []
    if args.action == "run":
        if len(argv) < 4 or argv[2] != "--":
            run.error("expected ID|CSV|all -- COMMAND [ARG ...]")
        command = argv[3:]
    try:
        if not os.environ.get("HOME"):
            os.environ["HOME"] = pwd.getpwuid(os.getuid()).pw_dir
        return execute(args, command)
    except (FleetError, OSError, ValueError) as error:
        print(f"xenoid-fleet: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
