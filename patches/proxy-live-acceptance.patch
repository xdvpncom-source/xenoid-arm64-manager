+@case("proxyLiveAcceptanceDistinguishesPlannerIntent")
+def proxy_live_acceptance_distinguishes_planner_intent() -> None:
+    epoch = OBSERVATION_DIGEST
+    generation = 7
+    counters = {"ingress": 1, "proxyUplink": 1, "egress": 1}
+    capabilities = {
+        "v4DnsProxy": True,
+        "v4TcpProxy": True,
+        "v4UdpProxy": False,
+        "v6DnsProxy": False,
+        "v6TcpProxy": False,
+        "v6UdpProxy": False,
+    }
+    host = {
+        "ok": True,
+        "generation": generation,
+        "runtimeEpoch": epoch,
+        "phase": "active",
+        "structuralApplied": True,
+        "dataPlaneVerified": False,
+        "counters": counters,
+    }
+    report = {
+        "checkId": 1,
+        "generation": generation,
+        "phase": "active",
+        "structuralApplied": True,
+        "dataPlaneVerified": True,
+        "capabilities": capabilities,
+        "counters": counters,
+    }
+    daemon = {
+        "bootstrap": {"components": {"proxy": {"ok": True}}},
+        "proxy": {
+            "ok": True,
+            "stateReadable": True,
+            "enabled": True,
+            "configured": True,
+            "quarantined": False,
+            "udpAllowed": False,
+            "ipv6Allowed": False,
+            "generation": generation,
+            "runtimeEpoch": epoch,
+            "checkId": 1,
+            "report": report,
+            "probe": {"checkId": 1, "capabilities": capabilities},
+        },
+    }
+
+    def check(snapshot_overrides=None, host_overrides=None):
+        snapshot = {
+            "components": {
+                "proxy": {
+                    "quarantineRequired": True,
+                    "engine": {**host, **(host_overrides or {})},
+                },
+            },
+            **(snapshot_overrides or {}),
+        }
+        checks = live_observe._Checks()
+        live_observe.LiveAcceptance()._proxy_checks(
+            None,
+            snapshot,
+            {"proxyGeneration": generation, "runtimeEpoch": epoch},
+            {},
+            daemon,
+            live_observe._Budget(None),
+            checks,
+        )
+        return checks
+
+    observed = check()
+    require(observed.first_failure() is None, "planner intent rejected live proxy proof")
+
+    for name, overrides, host_overrides in (
+        ("snapshot flag", {"proxyQuarantined": True}, {}),
+        ("host flag", {"proxyQuarantined": False}, {"quarantined": True}),
+        ("host phase", {"proxyQuarantined": False}, {"phase": "quarantined"}),
+    ):
+        observed = check(overrides, host_overrides)
+        require(
+            observed.values["proxyHostQuarantine"]
+            == {"ok": False, "code": "proxy_quarantined"},
+            f"actual quarantine was ignored: {name}",
+        )
+
+    report["dataPlaneVerified"] = False
+    observed = check()
+    require(
+        observed.values["proxyDataPlane"]
+        == {"ok": False, "code": "proxy_data_plane_unverified"},
+        "proxy passed without daemon data-plane proof",
+    )
+
+
 @case("googleBootstrapGateDispatch")
