+
+class TransientTransportFailure(AgentFailure):
+    """A known network/socket resource failure, never an authentication failure."""
+
+
+def _transport_failure(error: OSError) -> AgentFailure:
+    retryable = {
+        errno.EAGAIN, errno.EINTR, errno.EMFILE, errno.ENFILE,
+        errno.EADDRINUSE, errno.EADDRNOTAVAIL, errno.ECONNABORTED,
+        errno.ECONNREFUSED, errno.ECONNRESET, errno.EHOSTUNREACH,
+        errno.ENETDOWN, errno.ENETUNREACH,
+        errno.EPIPE, errno.ETIMEDOUT,
+    }
+    if isinstance(error, TimeoutError) or error.errno in retryable:
+        return TransientTransportFailure("engine_unavailable")
+    return AgentFailure("engine_unavailable")
+
+
+def _sleep_stoppable(seconds: float) -> None:
+    deadline = time.monotonic() + seconds
+    while not _STOP:
+        remaining = deadline - time.monotonic()
+        if remaining <= 0:
+            break
+        time.sleep(min(1.0, remaining))
