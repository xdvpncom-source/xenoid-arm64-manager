+# The host owns domain routing independently of the encrypted proxy source.
+# Source compilation remains pure; the native agent attaches this policy after
+# its networkless worker returns and the root engine validates the exact result.
+PROXY_ROUTING_SCHEMA = 'dev.xenoid.qa.proxy-routing/v1'
+PROXY_ROUTING_PATH = '/etc/xenoid/qa-proxy-routing.json'
+PROXY_ROUTING_DIRECT_DNS = (
+    'https://8.8.8.8/dns-query#DIRECT',
+    'https://8.8.4.4/dns-query#DIRECT',
+)
+
+
+class ProxyRoutingError(ValueError):
+    pass
+
+
+def normalize_proxy_routing_domain(value):
+    if (not isinstance(value, str) or not value
+            or any(c.isspace() or unicodedata.category(c).startswith('C') for c in value)):
+        raise ProxyRoutingError('routing_policy_invalid')
+    candidate = value[:-1] if value.endswith('.') else value
+    try:
+        domain = candidate.encode('idna').decode('ascii').lower()
+    except (UnicodeError, ValueError) as exc:
+        raise ProxyRoutingError('routing_policy_invalid') from exc
+    label = re.compile(r'[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\Z')
+    if not domain or len(domain) > 253 or not all(label.fullmatch(part) for part in domain.split('.')):
+        raise ProxyRoutingError('routing_policy_invalid')
+    try:
+        ipaddress.ip_address(domain)
+    except ValueError:
+        pass
+    else:
+        raise ProxyRoutingError('routing_policy_invalid')
+    return domain
+
+
+def normalize_proxy_routing_policy(value):
+    if (not isinstance(value, dict) or set(value) - {'schema', 'exceptions'}
+            or value.get('schema', PROXY_ROUTING_SCHEMA) != PROXY_ROUTING_SCHEMA
+            or not isinstance(value.get('exceptions'), list)):
+        raise ProxyRoutingError('routing_policy_invalid')
+    entries, seen = [], set()
+    for item in value['exceptions']:
+        if (not isinstance(item, dict) or set(item) != {'domain', 'include_subdomains'}
+                or type(item['include_subdomains']) is not bool):
+            raise ProxyRoutingError('routing_policy_invalid')
+        domain = normalize_proxy_routing_domain(item['domain'])
+        key = (domain, item['include_subdomains'])
+        if key not in seen:
+            entries.append({'domain': domain, 'include_subdomains': item['include_subdomains']})
+            seen.add(key)
+    return {'schema': PROXY_ROUTING_SCHEMA, 'exceptions': entries}
+
+
+def load_proxy_routing_policy(path=PROXY_ROUTING_PATH):
+    """Read an administrator-owned profile; missing file preserves global mode."""
+    import os
+    import stat
+    from pathlib import Path
+    p = Path(path)
+    if not p.is_absolute():
+        raise ProxyRoutingError('routing_policy_invalid')
+    parent = Path('/')
+    for part in p.parts[1:-1]:
+        parent /= part
+        try:
+            info = parent.lstat()
+        except FileNotFoundError:
+            return {'schema': PROXY_ROUTING_SCHEMA, 'exceptions': []}
+        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o022
+                or not (stat.S_IMODE(info.st_mode) & 0o001)):
+            raise ProxyRoutingError('routing_policy_invalid')
+    try:
+        descriptor = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | getattr(os, 'O_CLOEXEC', 0))
+    except FileNotFoundError:
+        return {'schema': PROXY_ROUTING_SCHEMA, 'exceptions': []}
+    except OSError as exc:
+        raise ProxyRoutingError('routing_policy_invalid') from exc
+    try:
+        with os.fdopen(descriptor, 'rb') as stream:
+            info = os.fstat(stream.fileno())
+            if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_nlink != 1
+                    or stat.S_IMODE(info.st_mode) != 0o644 or info.st_size > MAX_SOURCE_BYTES):
+                raise ProxyRoutingError('routing_policy_invalid')
+            body = stream.read(MAX_SOURCE_BYTES + 1)
+            if len(body) > MAX_SOURCE_BYTES:
+                raise ProxyRoutingError('routing_policy_invalid')
+    except OSError as exc:
+        raise ProxyRoutingError('routing_policy_invalid') from exc
+    try:
+        return normalize_proxy_routing_policy(json.loads(body))
+    except (UnicodeError, ValueError) as exc:
+        raise ProxyRoutingError('routing_policy_invalid') from exc
+
+
+def proxy_routing_rules(policy):
+    policy = normalize_proxy_routing_policy(policy)
+    entries = sorted({(item['domain'], item['include_subdomains']) for item in policy['exceptions']})
+    suffixes = {domain for domain, suffix in entries if suffix}
+    rules = []
+    for domain, suffix in entries:
+        if any(domain.endswith('.' + parent) or domain == parent and not suffix
+               for parent in suffixes if parent != domain or not suffix):
+            continue
+        rules.append(('DOMAIN-SUFFIX' if suffix else 'DOMAIN') + ',' + domain + ',DIRECT')
+    return rules + ['MATCH,GLOBAL']
+
+
+def proxy_routing_policy_from_rules(rules):
+    if not isinstance(rules, list) or not rules or rules[-1] != 'MATCH,GLOBAL':
+        raise ProxyRoutingError('routing_policy_invalid')
+    entries = []
+    for rule in rules[:-1]:
+        if not isinstance(rule, str):
+            raise ProxyRoutingError('routing_policy_invalid')
+        fields = rule.split(',')
+        if len(fields) != 3 or fields[0] not in ('DOMAIN', 'DOMAIN-SUFFIX') or fields[2] != 'DIRECT':
+            raise ProxyRoutingError('routing_policy_invalid')
+        domain = normalize_proxy_routing_domain(fields[1])
+        if domain != fields[1]:
+            raise ProxyRoutingError('routing_policy_invalid')
+        entries.append({'domain': domain, 'include_subdomains': fields[0] == 'DOMAIN-SUFFIX'})
+    policy = {'schema': PROXY_ROUTING_SCHEMA, 'exceptions': entries}
+    if rules != proxy_routing_rules(policy):
+        raise ProxyRoutingError('routing_policy_invalid')
+    return policy
+
+
+def proxy_routing_dns_policy(policy):
+    rules = proxy_routing_rules(policy)
+    return {('+' + '.' if rule.startswith('DOMAIN-SUFFIX,') else '') + rule.split(',')[1]: list(PROXY_ROUTING_DIRECT_DNS)
+            for rule in rules[:-1]}
+
+
+def apply_proxy_routing_config(config, policy):
+    result = json.loads(json.dumps(config, ensure_ascii=True, allow_nan=False))
+    rules = proxy_routing_rules(policy)
+    result['mode'] = 'rule' if len(rules) > 1 else 'global'
+    result['rules'] = rules
+    dns_policy = proxy_routing_dns_policy(policy)
+    if dns_policy:
+        result['dns']['nameserver-policy'] = dns_policy
+    else:
+        result['dns'].pop('nameserver-policy', None)
+    return result
+
+
+def validate_proxy_routing_config(config, policy=None):
+    """Old root-owned candidates stay readable during a policy transition.
+
+    write-config supplies the current policy and therefore cannot stage any
+    additional DIRECT destination, GLOBAL/DIRECT fallback or unrelated DNS rule.
+    """
+    embedded = proxy_routing_policy_from_rules(config.get('rules'))
+    expected = apply_proxy_routing_config(config, embedded if policy is None else policy)
+    if (config.get('mode') != expected['mode'] or config.get('rules') != expected['rules']
+            or (config.get('dns') or {}).get('nameserver-policy') != expected['dns'].get('nameserver-policy')):
+        raise ProxyRoutingError('routing_policy_invalid')
+    return embedded
