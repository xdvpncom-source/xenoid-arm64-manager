+                    "context_sha256": self._identity_digest(context), "location_sha256": self._identity_digest(location)}
+                version = db.execute("SELECT source FROM device_script_versions WHERE script_id=? AND version=?",
+                                     (row["script_id"], row["version"])).fetchone()
+                state = request.get("native_state")
