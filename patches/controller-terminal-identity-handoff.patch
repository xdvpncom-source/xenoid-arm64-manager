+                        or request.get("binding") != native_binding
+                        or request.get("native_transaction") != head[1]
+                        or request.get("request_sha256") != self._identity_digest({k: v for k, v in request.items() if k != "request_sha256"})
+                        or json.loads(head[7]) != {"kind": "committed_native_readback", "sha256": request["request_sha256"]}):
+                    raise RemoteError("Terminal native identity finalization is unconfirmed")
+                target, before, context, location = (request[k] for k in ("target", "native_before", "context", "location_sidecar"))
