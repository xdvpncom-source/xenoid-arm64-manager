+            if (current is None or current["phase"] not in {"tracking", "draining"}
+                    or any(current[k] != row[k] for k in ("host_id", "device_id", "instance_id", "resource_tag",
+                        "startup_container_id", "identity_container_id", "script_id", "version", "is_current", "phase"))):
+                raise RemoteError("Terminal native identity controller owner changed")
+            ledger._current(db, binding)
+            head = ledger._head(db, binding)
+            if (head is None or head[5] != "current" or head[2] != ledger._raw(binding).decode()
+                    or db.execute("SELECT 1 FROM native_identity_generations WHERE owner=? AND phase='reserved'",
